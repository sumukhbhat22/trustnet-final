FROM python:3.12-slim
WORKDIR /app/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
RUN useradd --system --uid 10001 --home-dir /app trustnet \
 && mkdir -p /app/backend/data /app/backend/models/saved_models \
 && chown -R trustnet:trustnet /app
USER trustnet
ENV TRUSTNET_ENV=production
EXPOSE 8010
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8010"]
