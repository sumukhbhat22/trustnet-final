# Copy to .env for local use. Never commit real secrets.
TRUSTNET_ENV=development
TRUSTNET_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUSTNET_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
TRUSTNET_DB_PATH=backend/data/trustnet.db
DEMO_MODE=0
# Local development only: let the built-in sumukh demo admin enroll a new browser at login.
TRUSTNET_DEMO_ALLOW_NEW_DEVICE=0
VITE_ML_API_URL=http://localhost:8010/api
# Optional SMTP for email MFA and notifications. Leave unset for local demo-code mode.
TRUSTNET_SMTP_HOST=
TRUSTNET_SMTP_PORT=587
TRUSTNET_SMTP_USER=
TRUSTNET_SMTP_PASSWORD=
TRUSTNET_SMTP_FROM=trustnet@localhost
TRUSTNET_SMTP_STARTTLS=1
# Production bootstrap only; set both before first startup.
TRUSTNET_BOOTSTRAP_ADMIN_EMAIL=
TRUSTNET_BOOTSTRAP_ADMIN_PASSWORD=
# Optional country allow-list for login policy (ISO 3166-1 alpha-2 codes, e.g. US,GB,IN).
# Empty means country enforcement is disabled. Private/LAN addresses always bypass.
TRUSTNET_ALLOWED_COUNTRIES=
TRUSTNET_BUSINESS_TIMEZONE=Asia/Kolkata

# Set to 1 only if you really feed external telemetry into POST /api/events/ingest (source="external").
# Unset/0: external-source events are refused with 403.
TRUSTNET_ALLOW_EXTERNAL_INGEST=0
